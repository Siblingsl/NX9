{
  // 隔离验证配置（大师运镜库接入 3D 导演台）：只编译本次新增 / 改动的文件。
  //
  // 为什么需要它：`packages/shared` 的源码 barrel（index.ts）引用了 8 个**不存在**的
  // data/* 模块（emotion-presets / shot-move-families / creative-asset-presets /
  // character-face-rig-presets / playbook-definitions / camera-presets /
  // shot-lexicon-taxonomy / provider-registry），`pnpm --filter @nx9/shared build` 与
  // `pnpm --filter @nx9/web typecheck` 都因此跑不通（既有缺陷，不在本次范围内）。
  //
  // 预期噪声：`packages/shared/src/index.ts` 自己的这 8 条 TS2307 会各报一条；
  // 本次改动自身（本文件 include 的路径）不应出现任何错误。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@nx9/shared": ["../../packages/shared/src/index.ts"],
      "@nx9/director3d": ["../../packages/director3d/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/engine/__tests__/director3d-camera-move-motion.test.ts",
    "src/engine/__tests__/director3d-camera-move-library-panel.test.tsx",
    "../../packages/director3d/src/schema/cameraMoveMotion.ts",
    "../../packages/director3d/src/schema/cameraMoveTimelineKeys.ts",
    "../../packages/director3d/src/schema/cameraGeometry.ts",
    "../../packages/director3d/src/schema/directorProject.ts",
    "../../packages/director3d/src/store/directorStore.ts",
    "../../packages/director3d/src/store/moveTimelineStore.ts",
    "../../packages/director3d/src/ui/CameraMoveLibraryPanel.tsx",
    "../../packages/director3d/src/ui/CameraMoveTimelineRail.tsx",
    "../../packages/director3d/src/ui/StageRail.tsx",
    "../../packages/director3d/src/ui/StageMobileDock.tsx",
    "../../packages/director3d/src/ui/StageDeckShell.tsx",
    "../../packages/director3d/src/index.ts",
    "../../packages/shared/src/data/camera-move-library.ts",
    "../../packages/shared/src/types/camera-move-timeline.ts",
    "../../packages/shared/src/utils/camera-move-timeline.ts"
  ]
}
