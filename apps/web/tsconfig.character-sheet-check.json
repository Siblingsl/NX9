{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@nx9/shared": ["../../packages/shared/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/blocks/core/CharacterSheetBlock.tsx",
    "src/blocks/registry.tsx",
    "src/engine/character-sheet-closure.ts",
    "src/engine/flow-runner-ops/character-sheet-ops.ts",
    "src/engine/flow-runner.ts",
    "src/engine/stage-deck/chrome/attached-workspace/AttachedWorkspaceRouter.tsx",
    "src/engine/stage-deck/chrome/attached-workspace/tool/CharacterSheetWorkspace.tsx",
    "src/engine/__tests__/character-sheet-plan.test.ts",
    "src/engine/__tests__/character-sheet-block-map.test.ts",
    "src/engine/__tests__/character-sheet-closure.test.ts"
  ]
}
